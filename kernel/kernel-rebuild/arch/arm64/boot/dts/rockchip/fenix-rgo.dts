			rockchip,camera-module-index = <0x00>;
			rockchip,camera-module-facing = "back";
			rockchip,camera-module-name = "RK628-CSI";
			rockchip,camera-module-lens-name = "NC";
			phandle = <0x10e>;

			port {

				hdmiin_out0: endpoint {
