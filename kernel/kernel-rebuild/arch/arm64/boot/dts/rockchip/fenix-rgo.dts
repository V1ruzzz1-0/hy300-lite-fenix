	key: key {
		compatible = "rockchip,key";
		io-channels = <0xce 0x02>;
		phandle = <0x18a>;

		power-key {
			linux,code = <0x74>;
			label = "KEY_POWER";
			rockchip,adc_value = <0x03>;
			gpio-key,wakeup;
		};
