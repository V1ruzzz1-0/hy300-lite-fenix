		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0x131>;

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				dsi_in_vopb: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <0x14>;
					phandle = <0xaa>;
				};

				dsi_in_vopl: endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <0xa5>;
					phandle = <0xae>;
				};
			};

			port@1 {
				reg = <0x01>;

				dsi_out_panel: endpoint {
					remote-endpoint = <0xa6>;
					phandle = <0xa7>;
				};
			};
		};

		panel@0 {
			reg = <0x00>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					panel_in_dsi: endpoint {
						remote-endpoint = <0xa7>;
						phandle = <0xa6>;
					};
				};
			};
		};
	};

