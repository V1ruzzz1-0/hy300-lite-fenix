		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0xd6>;
		rockchip,cmd-type = "spi";
		phandle = <0x18c>;

		display-timings {
			native-mode = <0xd7>;

			timing0: timing0 {
				clock-frequency = <0x3197500>;
				hactive = <0x400>;
				vactive = <0x258>;
				hback-porch = <0x6e>;
				hfront-porch = <0x6e>;
				vback-porch = <0x04>;
				vfront-porch = <0x32>;
				hsync-len = <0x5a>;
				vsync-len = <0x04>;
				hsync-active = <0x00>;
				vsync-active = <0x00>;
				de-active = <0x00>;
				pixelclk-active = <0x00>;
				phandle = <0xd7>;
			};
		};

		port {

			panel_in_lvds: endpoint {
				remote-endpoint = <0xd8>;
				phandle = <0x51>;
			};
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0xd9 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0xda>;
		reset-gpios = <0x62 0x02 0x01>;
		phandle = <0xa0>;
	};

	vccsys: vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		phandle = <0x6a>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		clocks = <0xd9 0x01>;
		clock-names = "ext_clock";
		wifi_chip_type = [00];
		WIFI,host_wake_irq = <0x62 0x0a 0x00>;
		bl_en_gpio = <0x62 0x00 0x01>;
		fan_on_gpio = <0x62 0x10 0x01>;
		host_for_en = <0x6e 0x11 0x00>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0xd9 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0xdb 0x13 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0xdc 0xdd>;
		pinctrl-1 = <0xde>;
		BT,reset_gpio = <0x62 0x11 0x00>;
		BT,wake_gpio = <0x62 0x01 0x00>;
		BT,wake_host_irq = <0x62 0x0b 0x00>;
		status = "okay";
	};

