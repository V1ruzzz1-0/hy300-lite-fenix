				ocv_table = <0xdac 0xddc 0xe08 0xe34 0xe67 0xe9c 0xec4 0xede 0xef3 0xf06 0xf18 0xf31 0xf59 0xf7c 0xf99 0xfaf 0xfbe 0xfc9 0xfd8 0xfec 0x1034>;
